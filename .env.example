# Copy these values into your local environment. Never commit a real secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local MongoDB defaults are shown; configure credentials in the URI as needed.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=e_learning
MONGODB_SESSIONS_COLLECTION=django_sessions

# Google Gemini server-side quiz generation. Never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
QUIZ_AI_GENERATION_LIMIT=5
QUIZ_AI_GENERATION_WINDOW_SECONDS=3600

# Optional, used only by the controlled admin-account provisioning service.
USERS_ADMIN_BOOTSTRAP_TOKEN=

# Production-only examples (select config.settings.production).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Email Configuration (Brevo SMTP or Gmail)
# DJANGO_EMAIL_BACKEND=apps.mentors.email_backend.BrevoEmailBackend
# brevo_smtp_key=your-brevo-smtp-key
# BREVO_SENDER_NAME="AquaSecure"
# BREVO_SENDER_EMAIL=your-verified-sender@gmail.com
# EMAIL_FROM=your-verified-sender@gmail.com
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user@smtp-brevo.com
# SMTP_PASS=your-smtp-password
# BREVO_SSL_VERIFY=false
# SITE_URL=http://127.0.0.1:8000

# Groq AI Service (Mentor Recommendations & Goal Understanding)
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# LiveKit Real-Time Virtual Classroom
# LIVEKIT_URL=wss://your-project-livekit-url
# LIVEKIT_API_KEY=your_livekit_api_key
# LIVEKIT_API_SECRET=your_livekit_api_secret
# LIVEKIT_TOKEN_TTL_SECONDS=900
# CLASSROOM_EARLY_JOIN_MINUTES=15
# CLASSROOM_LATE_JOIN_GRACE_MINUTES=180

