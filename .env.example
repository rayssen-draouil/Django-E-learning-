# Copy these values into your local environment. Never commit a real secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local MongoDB defaults are shown; configure credentials in the URI as needed.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=e_learning
MONGODB_SESSIONS_COLLECTION=django_sessions

# Optional, used only by the controlled admin-account provisioning service.
USERS_ADMIN_BOOTSTRAP_TOKEN=

# AI writing assistant. Leave the key empty to disable the feature gracefully.
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-haiku-latest
AI_TIMEOUT=20

# Celery. Development uses eager tasks and an in-memory result backend by default.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_STORE_EAGER_RESULT=false

# Production-only examples (select config.settings.production).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
