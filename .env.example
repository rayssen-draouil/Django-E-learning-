# Copy these values into your local environment. Never commit a real secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local MongoDB defaults are shown; configure credentials in the URI as needed.
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=e_learning
MONGODB_SESSIONS_COLLECTION=django_sessions

# Local Ollama service used to generate learning-path drafts.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=90

# Optional, used only by the controlled admin-account provisioning service.
USERS_ADMIN_BOOTSTRAP_TOKEN=

# Production-only examples (select config.settings.production).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
